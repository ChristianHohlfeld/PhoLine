{
  "manifest_version": 3,
  "name": "PhoLine",
  "version": "1.1.0",
  "description": "PhO filter on the wire. Rewrites chat requests before the tokenizer. Client expands.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhoLine",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "world": "MAIN",
      "run_at": "document_start",
      "js": ["pho.js", "hook.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    },
    {
      "world": "ISOLATED",
      "run_at": "document_idle",
      "js": ["pho.js", "content.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
